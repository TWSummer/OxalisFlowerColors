{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Redwood Sorrel review audit entry v2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "taxon_id",
    "reviewer",
    "reviewed_at",
    "protocol_version",
    "examined_photo_ids",
    "color",
    "veins",
    "existing_fields",
    "write_status",
    "verified_fields",
    "ring",
    "variation"
  ],
  "properties": {
    "observation_id": {
      "type": "integer",
      "minimum": 1
    },
    "taxon_id": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "protocol_version": {
      "const": "2.0.0"
    },
    "examined_photo_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "color": {
      "$ref": "#/$defs/color"
    },
    "veins": {
      "$ref": "#/$defs/veins"
    },
    "existing_fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "write_status": {
      "enum": [
        "not_attempted",
        "already_present",
        "conflict",
        "blocked",
        "attempted",
        "verified",
        "failed",
        "withdrawn"
      ]
    },
    "verified_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_id",
          "value",
          "verified_at"
        ],
        "properties": {
          "field_id": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "string"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "ring": {
      "$ref": "#/$defs/ring"
    },
    "variation": {
      "$ref": "#/$defs/variation"
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "value"
      ],
      "properties": {
        "field_id": {
          "type": "integer",
          "minimum": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "trait": {
      "type": "object",
      "required": [
        "value",
        "status",
        "confidence",
        "reason",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "scored",
            "cannot_be_determined",
            "no_open_flower",
            "out_of_scope",
            "not_assessed"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "photo_id",
              "flower",
              "source_diameter_px",
              "assessment_diameter_px",
              "visible_upper_petals"
            ],
            "properties": {
              "photo_id": {
                "type": "integer",
                "minimum": 1
              },
              "flower": {
                "type": "string",
                "minLength": 1
              },
              "source_diameter_px": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "assessment_diameter_px": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "visible_upper_petals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "scored"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "not": {
                  "const": "Cannot be determined"
                }
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cannot_be_determined"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "const": "Cannot be determined"
              },
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_open_flower",
                  "out_of_scope",
                  "not_assessed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "color": {
      "allOf": [
        {
          "$ref": "#/$defs/trait"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "White",
                "Pink",
                "Purple",
                "Cannot be determined",
                null
              ]
            }
          }
        }
      ]
    },
    "veins": {
      "allOf": [
        {
          "$ref": "#/$defs/trait"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "Low",
                "Medium",
                "High",
                "Cannot be determined",
                null
              ]
            }
          }
        }
      ]
    },
    "ring": {
      "allOf": [
        {
          "$ref": "#/$defs/trait"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "Present",
                "Absent",
                "Cannot be determined",
                null
              ]
            }
          }
        }
      ]
    },
    "variation": {
      "allOf": [
        {
          "$ref": "#/$defs/trait"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "None",
                "Low",
                "High",
                "Cannot be determined",
                null
              ]
            }
          }
        }
      ]
    }
  }
}
